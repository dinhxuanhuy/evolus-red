# Evolus workspace credentials (server-side only, never expose to the frontend)
EVOLUS_API_KEY=evo_xxx
EVOLUS_APPLICATION_ID=00000000-0000-0000-0000-000000000000

# Agents used by the orchestrator
# ReconAgent
EVOLUS_RECON_AGENT=00000000-0000-0000-0000-000000000000
# RedTeamAttacker (probe generator)
EVOLUS_ATTACKER_AGENT=00000000-0000-0000-0000-000000000000
# ExplainJudge (verdict + remediation)
EVOLUS_JUDGE_AGENT=00000000-0000-0000-0000-000000000000
# Planner (deep analysis, used by the AttackLoop workflow)
EVOLUS_PLANNER_AGENT=00000000-0000-0000-0000-000000000000

# AttackLoop workflow id (Deep scan)
EVOLUS_WORKFLOW_ID=00000000-0000-0000-0000-000000000000

# Optional: override the Evolus API base URL (gateway/proxy, or a fake server
# for local tests). Defaults to https://api.evolus.ai
# EVOLUS_BASE_URL=https://api.evolus.ai

# Server port
PORT=8787

# SQLite directory (defaults to ./data). On a PaaS with a mounted volume set it
# to the mount, e.g. DATA_DIR=/data on Railway.
# DATA_DIR=/data

# Extra CORS origins allowed to call this API (comma separated); localhost is
# always allowed. Add the deployed frontend origin when the web app is hosted
# separately from the API (e.g. Vercel).
# CORS_ORIGINS=https://evolus-red.vercel.app
